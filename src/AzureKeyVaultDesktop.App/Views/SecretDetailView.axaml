<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AzureKeyVaultDesktop.App.ViewModels"
             xmlns:models="using:AzureKeyVaultDesktop.Core.Models"
             xmlns:loc="using:AzureKeyVaultDesktop.App.Services.Localization"
             x:Class="AzureKeyVaultDesktop.App.Views.SecretDetailView"
             x:DataType="vm:SecretDetailViewModel">
    <StackPanel Spacing="14" MaxWidth="480">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="{Binding [SecretDetail_BackToSecrets], Source={x:Static loc:LocalizationService.Instance}}" Command="{Binding BackCommand}" />
            <TextBlock Text="{Binding SecretName}" Classes="pageTitle" VerticalAlignment="Center" />
        </StackPanel>

        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />

        <StackPanel Spacing="4" IsVisible="{Binding !IsEditing}">
            <TextBlock Text="{Binding [SecretDetail_Version], Source={x:Static loc:LocalizationService.Instance}}" Classes="subtitle" />
            <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:SecretVersionSummary">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#9679;" FontSize="10" Foreground="#0078D4" VerticalAlignment="Center" IsVisible="{Binding IsCurrent}" />
                            <TextBlock Text="{Binding UpdatedOn}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <TextBox Text="{Binding RevealedValue}"
                 IsReadOnly="True"
                 Watermark="{Binding [SecretDetail_ValueHidden], Source={x:Static loc:LocalizationService.Instance}}"
                 FontFamily="monospace"
                 IsVisible="{Binding !IsEditing}" />

        <StackPanel Spacing="4" IsVisible="{Binding !IsEditing}">
            <TextBlock Text="{Binding [SecretDetail_ContentType], Source={x:Static loc:LocalizationService.Instance}}" Classes="subtitle" />
            <TextBlock Text="{Binding ContentType}" />
        </StackPanel>

        <StackPanel Spacing="4" IsVisible="{Binding IsEditing}">
            <TextBlock Text="{Binding [SecretDetail_NewValue], Source={x:Static loc:LocalizationService.Instance}}" Classes="subtitle" />
            <TextBox Text="{Binding EditedValue}" AcceptsReturn="True" Height="100" TextWrapping="Wrap" FontFamily="monospace" />
        </StackPanel>

        <StackPanel Spacing="4" IsVisible="{Binding IsEditing}">
            <TextBlock Text="{Binding [SecretDetail_ContentType], Source={x:Static loc:LocalizationService.Instance}}" Classes="subtitle" />
            <TextBox Text="{Binding EditedContentType}" Watermark="{Binding [SecretDetail_ContentTypeWatermark], Source={x:Static loc:LocalizationService.Instance}}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsEditing}">
            <Button Content="{Binding [SecretDetail_Reveal], Source={x:Static loc:LocalizationService.Instance}}" Command="{Binding RevealCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Content="{Binding [SecretDetail_Copy], Source={x:Static loc:LocalizationService.Instance}}" Classes="accent" Command="{Binding CopyCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Content="{Binding [SecretDetail_UpdateValue], Source={x:Static loc:LocalizationService.Instance}}" Command="{Binding BeginEditCommand}" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEditing}">
            <Button Content="{Binding [SecretDetail_SaveNewVersion], Source={x:Static loc:LocalizationService.Instance}}" Classes="accent" Command="{Binding SaveNewVersionCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Content="{Binding [Common_Cancel], Source={x:Static loc:LocalizationService.Instance}}" Command="{Binding CancelEditCommand}" />
        </StackPanel>

        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Opacity="0.75" />
    </StackPanel>
</UserControl>
