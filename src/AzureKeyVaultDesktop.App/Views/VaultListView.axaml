<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AzureKeyVaultDesktop.App.ViewModels"
             xmlns:loc="using:AzureKeyVaultDesktop.App.Services.Localization"
             x:Class="AzureKeyVaultDesktop.App.Views.VaultListView"
             x:DataType="vm:VaultListViewModel">
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Text="{Binding [VaultList_Title], Source={x:Static loc:LocalizationService.Instance}}" Classes="pageTitle" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{Binding [Common_Refresh], Source={x:Static loc:LocalizationService.Instance}}" Command="{Binding RefreshCommand}" Margin="4,0" />
            <Button Grid.Column="2" Content="{Binding [Common_Settings], Source={x:Static loc:LocalizationService.Instance}}" Command="{Binding OpenSettingsCommand}" Margin="4,0" />
            <Button Grid.Column="3" Content="{Binding [Common_SignOut], Source={x:Static loc:LocalizationService.Instance}}" Command="{Binding SignOutCommand}" Margin="4,0" />
        </Grid>

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBox Grid.Column="0" Text="{Binding SearchText}" Watermark="{Binding [VaultList_SearchWatermark], Source={x:Static loc:LocalizationService.Instance}}" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Subscriptions}" SelectedItem="{Binding SelectedSubscription}" MinWidth="200" />
        </Grid>

        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" Margin="0,0,0,8" />

        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="OrangeRed" Margin="0,0,0,8" />

        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding [VaultList_NoResults], Source={x:Static loc:LocalizationService.Instance}}"
                   Classes="hint"
                   Margin="0,4,0,0"
                   IsVisible="{Binding NoResultsVisible}" />

        <ListBox ItemsSource="{Binding DisplayedVaults}" SelectedItem="{Binding SelectedItem}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:VaultListItem">
                    <StackPanel>
                        <TextBlock Text="{Binding GroupHeader}"
                                   IsVisible="{Binding HasGroupHeader}"
                                   FontWeight="SemiBold"
                                   Opacity="0.6"
                                   FontSize="12"
                                   Margin="2,10,2,4" />
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Grid.Column="0"
                                    Width="36" Height="36"
                                    CornerRadius="18"
                                    Background="#1F0078D4"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                                <TextBlock Text="&#128274;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Vault.Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Vault.Location}" Classes="subtitle" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#8250;" Opacity="0.4" FontSize="18" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
