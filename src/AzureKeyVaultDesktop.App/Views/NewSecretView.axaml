<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AzureKeyVaultDesktop.App.ViewModels"
             xmlns:loc="using:AzureKeyVaultDesktop.App.Services.Localization"
             x:Class="AzureKeyVaultDesktop.App.Views.NewSecretView"
             x:DataType="vm:NewSecretViewModel">
    <StackPanel Spacing="14" MaxWidth="480">
        <TextBlock Text="{Binding [NewSecret_Title], Source={x:Static loc:LocalizationService.Instance}}" Classes="pageTitle" />

        <StackPanel Spacing="4">
            <TextBlock Text="{Binding [NewSecret_NameLabel], Source={x:Static loc:LocalizationService.Instance}}" Classes="subtitle" />
            <TextBox Text="{Binding Name}" Watermark="{Binding [NewSecret_NameWatermark], Source={x:Static loc:LocalizationService.Instance}}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="{Binding [NewSecret_ValueLabel], Source={x:Static loc:LocalizationService.Instance}}" Classes="subtitle" />
            <TextBox Text="{Binding Value}" AcceptsReturn="True" Height="100" TextWrapping="Wrap" />
        </StackPanel>

        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding [NewSecret_Create], Source={x:Static loc:LocalizationService.Instance}}" Classes="accent" Command="{Binding CreateCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Content="{Binding [Common_Cancel], Source={x:Static loc:LocalizationService.Instance}}" Command="{Binding CancelCommand}" />
        </StackPanel>

        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="OrangeRed" />
    </StackPanel>
</UserControl>
