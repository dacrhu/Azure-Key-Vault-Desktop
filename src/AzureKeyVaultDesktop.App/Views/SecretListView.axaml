<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AzureKeyVaultDesktop.App.ViewModels"
             xmlns:models="using:AzureKeyVaultDesktop.Core.Models"
             xmlns:loc="using:AzureKeyVaultDesktop.App.Services.Localization"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="AzureKeyVaultDesktop.App.Views.SecretListView"
             x:DataType="vm:SecretListViewModel">
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Content="{Binding [SecretList_BackToVaults], Source={x:Static loc:LocalizationService.Instance}}" Command="{Binding BackCommand}" />
                <TextBlock Text="{Binding VaultName}" Classes="pageTitle" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Content="{Binding [Common_Refresh], Source={x:Static loc:LocalizationService.Instance}}" Command="{Binding RefreshCommand}" Margin="4,0" />
            <Button Grid.Column="2" Content="{Binding [SecretList_NewSecret], Source={x:Static loc:LocalizationService.Instance}}" Classes="accent" Command="{Binding NewSecretCommand}" Margin="4,0" />
        </Grid>

        <TextBox DockPanel.Dock="Top"
                 Text="{Binding SearchText}"
                 Watermark="{Binding [SecretList_SearchWatermark], Source={x:Static loc:LocalizationService.Instance}}"
                 Margin="0,0,0,12" />

        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" Margin="0,0,0,8" />

        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="OrangeRed" Margin="0,0,0,8" />

        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding [SecretList_NoResults], Source={x:Static loc:LocalizationService.Instance}}"
                   Classes="hint"
                   Margin="0,4,0,0"
                   IsVisible="{Binding NoResultsVisible}" />

        <ListBox ItemsSource="{Binding DisplayedSecrets}" SelectedItem="{Binding SelectedSecret}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:SecretSummary">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0"
                                Width="36" Height="36"
                                CornerRadius="18"
                                Background="#1F0078D4"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0">
                            <TextBlock Text="&#128273;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding UpdatedOn}" Classes="subtitle" />
                            <TextBlock Text="{Binding ContentType}"
                                       Classes="subtitle"
                                       IsVisible="{Binding ContentType, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="&#8250;" Opacity="0.4" FontSize="18" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
